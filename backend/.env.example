# uvicorn app.main:app --env-file .env
PG_DATA_DIR=./storage
DATABASE_URL=sqlite:///./storage/productgraph.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set a strong access key before exposing this service beyond localhost.
PG_API_KEY=
PG_REQUIRE_AUTH=1
# Set a long random token for first-owner setup; never commit its real value.
PG_SETUP_TOKEN=
# Default offline mode is explicitly lexical. Install requirements-ai.txt for semantic embeddings.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_PROVIDER=api uses OPENAI_BASE_URL and OPENAI_API_KEY.
API_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# Leave URI empty to run the identified NetworkX fallback.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
